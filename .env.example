# Local development defaults. `make setup` copies this to .env if you don't
# have one. Every variable here is read by go-home-server's config.Load.

# Required. Create the database first - this repo doesn't run Postgres for you:
#   createdb app
DATABASE_URL=postgres://localhost:5432/app?sslmode=disable

# Optional. Set it and the app serves file uploads; leave it unset and the
# /api/files routes aren't mounted at all. `make setup` creates ./uploads.
#
# When it IS set the app refuses to start if the directory doesn't exist or
# isn't writable, so a missing volume is a crash rather than uploads written
# somewhere that gets thrown away.
UPLOAD_DIR=./uploads

ADDR=:8080

# `production` turns on Secure cookies, which don't work over plain HTTP.
APP_ENV=development

# Set to true for a multi-user app. Default is first-account-only.
# ALLOW_OPEN_REGISTRATION=false

# Web push. Both keys or neither - one alone is a startup error. Generate with:
#   go run github.com/robert-crandall/go-home-server/cmd/vapid@latest
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Sign in with Google. All three or none - set any one of them and the app
# refuses to start until the other two are there, rather than quietly booting
# password-only. Create the OAuth client in the Google Cloud console; the
# redirect URL has to byte-match the "Authorized redirect URI" you enter there.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
